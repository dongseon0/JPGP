--- !u!114 &2042894265
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2042894264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 428712d8341fd414eb5edc578b2ccf9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  story:
  - speaker: "\uC679  \uC838"
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uB610 \uC624\uC138\uC694!"
    characterSprite: {fileID: 21300000, guid: 5ad23b296c5524352afef1745cfea644, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 2ccd05940268c4fcba710b7a7305e951, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uC624\uB298\uB3C4 \uAC00\uBC1C\uC744 \uB9CE\uC774 \uD314\uC558\uB124.
      \uC774\uC81C \uB0B4\uC77C \uD314 \uAC00\uBC1C\uC744 \uB9CC\uB4E4\uC5B4 \uBCFC\uAE4C?"
    characterSprite: {fileID: 21300000, guid: c56d3c690dc7a4e7c8af2e50832fbe22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 2ccd05940268c4fcba710b7a7305e951, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uC5B4\uB77C? \uAC00\uBC1C \uC7AC\uB8CC\uAC00 \uB2E4 \uB5A8\uC5B4\uC84C\uC796\uC544?
      \uB354 \uAD6C\uD558\uB7EC \uAC00\uC57C\uACA0\uB2E4."
    characterSprite: {fileID: 21300000, guid: c56d3c690dc7a4e7c8af2e50832fbe22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 2ccd05940268c4fcba710b7a7305e951, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uC751? \uBABB \uBCF4\uB358 \uD589\uC131\uC774\uB124? \uC5B4\uB514 \uD55C
      \uBC88..."
    characterSprite: {fileID: 21300000, guid: c56d3c690dc7a4e7c8af2e50832fbe22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 9afc4bf73aa20408084ba9e3fb678c38, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uC640\uC544...!"
    characterSprite: {fileID: 21300000, guid: c56d3c690dc7a4e7c8af2e50832fbe22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 1e4ce88977d07449d98a71c8583197ba, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uD0D0\uC2A4\uB7EC\uC6B4 \uBA38\uB9AC\uCE74\uB77D\uC744 \uAC00\uC9C4 \uAC1C\uCCB4\uAC00
      \uC800\uB807\uAC8C \uB9CE\uB2E4\uB2C8... \uB2E4\uC74C \uC7AC\uB8CC \uC218\uAE09\uCC98\uB294
      \uB108\uB85C \uC815\uD588\uB2E4!"
    characterSprite: {fileID: 21300000, guid: 5ad23b296c5524352afef1745cfea644, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 1e4ce88977d07449d98a71c8583197ba, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uC6B0\uB9AC \uC800 \u2018\uC778\uAC04\u2019\uC774\uB77C\uB294 \uAC1C\uCCB4\uB97C
      \uCD5C\uB300\uD55C \uB9CE\uC774 \uC7A1\uC544\uC11C, \uBA38\uB9AC\uCE74\uB77D\uC774
      \uC5C6\uB294 \uC678\uACC4\uC778\uB4E4\uC744 \uC704\uD574 \uAC00\uBC1C\uC744
      \uC794\uB729 \uB9CC\uB4E4\uC5B4 \uBCF4\uC790!"
    characterSprite: {fileID: 21300000, guid: 5ad23b296c5524352afef1745cfea644, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 1e4ce88977d07449d98a71c8583197ba, type: 3}
  - speaker: "\uC679  \uC838"
    text: "WASD\uB85C \uBC29\uD5A5\uC744 \uC870\uC791\uD558\uACE0, \uC2A4\uD398\uC774\uC2A4\uBC14\uB098
      \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uD0A4\uB85C \uC778\uAC04\uC744 \uB0A9\uCE58\uD560
      \uC218 \uC788\uC5B4."
    characterSprite: {fileID: 21300000, guid: 5ad23b296c5524352afef1745cfea644, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 1e4ce88977d07449d98a71c8583197ba, type: 3}
  - speaker: "\uC679  \uC838"
    text: "\uB9DE\uB2E4! \uAC15\uC544\uC9C0\uB294 \uC7A1\uC73C\uBA74 \uC548 \uB3FC.
      \uADC0\uC5FD\uAE34 \uD558\uC9C0\uB9CC, \uAC00\uBC1C \uC7AC\uB8CC\uB3C4 \uC548
      \uB418\uACE0 \uBC29\uD574\uB9CC \uB41C\uB2E4\uAD6C~"
    characterSprite: {fileID: 21300000, guid: c56d3c690dc7a4e7c8af2e50832fbe22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 1e4ce88977d07449d98a71c8583197ba, type: 3}
